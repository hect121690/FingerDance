<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TransparentDialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@drawable/rounded_dialog</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#DCDCE6</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:colorAccent">#00E5FF</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <item name="buttonBarPositiveButtonStyle">@style/DialogButtonStylePositive</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogButtonStyleNegative</item>
    </style>
    <style name="DialogButtonStylePositive" parent="@style/Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">#00E5FF</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DialogButtonStyleNegative" parent="@style/Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="size_font_ranking">
        <item name = "android:textSize">14dp</item>
    </style>
    <style name="DeleteChannelDialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@drawable/bg_delete_channel_dialog</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:colorAccent">#FF375F</item>
        <item name="buttonBarPositiveButtonStyle">@style/DeleteDialogButtonPositive</item>
        <item name="buttonBarNegativeButtonStyle">@style/DeleteDialogButtonNegative</item>
    </style>

    <style
        name="DeleteDialogButtonPositive"
        parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">

        <item name="android:textColor">#FF375F</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
    </style>

    <style
        name="DeleteDialogButtonNegative"
        parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">

        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="HelpCard">
        <item name="android:layout_height">155dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">14dp</item>
        <item name="android:background">@drawable/bg_help_card</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="HelpCardTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#16DDF3</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="HelpCardDescription">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#BFC9D3</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>

