<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutPads" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp">

    <RadioGroup
        android:id="@+id/radioGroupPads"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/fd_panel_light"
        android:orientation="horizontal"
        android:padding="8dp"
        android:weightSum="4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <RadioButton
            android:id="@+id/rbPadA"
            style="@style/FingerDanceOptionRadio"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center|start"
            android:text="A" />

        <RadioButton
            android:id="@+id/rbPadB"
            style="@style/FingerDanceOptionRadio"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center|start"
            android:text="B" />

        <RadioButton
            android:id="@+id/rbPadC"
            style="@style/FingerDanceOptionRadio"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center|start"
            android:text="C" />

        <RadioButton
            android:id="@+id/rbPadD"
            style="@style/FingerDanceOptionRadio"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center|start"
            android:text="D" />
    </RadioGroup>
    <LinearLayout android:id="@+id/padOptionsPanel" android:layout_width="0dp" android:layout_height="0dp" android:layout_marginTop="10dp" android:background="@drawable/fd_panel_glass" android:orientation="vertical" android:padding="12dp" app:layout_constraintBottom_toTopOf="@+id/btnGuardarPads" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@+id/radioGroupPads">

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/showImagePadA"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:text="Ocultar dibujos del Pad A"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/bg_pads_pictures"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/bg_pads_pictures" />

            <ImageView
                android:id="@+id/bg_pads"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/bg_pads" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView android:id="@+id/txPercentAlpha" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Opacidad del Pad B: 100%" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
        <SeekBar android:id="@+id/seekBarAlphaPadB" android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/padBPreviewPanel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerPadsB"
                android:layout_width="wrap_content"
                android:layout_height="93dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/imgPadBSelected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/padCPanel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="8dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerPadsC"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/imgPadCBg"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:srcCompat="@tools:sample/avatars" />

            <ImageView
                android:id="@+id/imgPadC"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/imgPadCBg"
                app:layout_constraintEnd_toEndOf="@+id/imgPadCBg"
                app:layout_constraintStart_toStartOf="@+id/imgPadCBg"
                app:layout_constraintTop_toTopOf="@+id/imgPadCBg"
                tools:srcCompat="@tools:sample/avatars" />

            <ProgressBar
                android:id="@+id/progressPadC"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/imgPadC"
                app:layout_constraintEnd_toEndOf="@id/imgPadC"
                app:layout_constraintStart_toStartOf="@id/imgPadC"
                app:layout_constraintTop_toTopOf="@id/imgPadC" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/linearPadsD"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="14dp" />
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnGuardarPads"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/fd_panel_glass"
        android:backgroundTint="@null"
        app:backgroundTint="@null"
        android:stateListAnimator="@null"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:includeFontPadding="false"
        android:text="GUARDAR Y SALIR"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>