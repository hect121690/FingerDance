<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/constraintBG" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp">

        <LinearLayout
            android:id="@+id/gameplaySettingsPanel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/fd_panel_dark"
            android:orientation="vertical"
            android:padding="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/btnOffline"
                style="@style/FingerDanceSwitch"
                android:text="Jugar Offline" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/btnNoteMidLine"
                style="@style/FingerDanceSwitch"
                android:text="Notas a media pantalla" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/btnNoCounter"
                style="@style/FingerDanceSwitch"
                android:text="Contador SelectSong" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/btnBreakSong"
                style="@style/FingerDanceSwitch"
                android:text="Cortar canción" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/btnHorizontalMode"
                style="@style/FingerDanceSwitch"
                android:text="Interfaz Horizontal" />

            <com.fingerdance.OptionStepperView
                android:id="@+id/optionOrientationSingle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                app:optionTitle="Orientacion Single"
                app:optionDefaultIndex="0"
                app:optionTitleColor="#FFFFFF"
                app:optionTitleSize="16dp"
                app:optionTitleStyle="bold"
                app:optionTextColor="#FFFFFF"
                app:optionTextSize="11dp"
                app:optionTextStyle="bold" />

            <com.fingerdance.OptionStepperView
                android:id="@+id/optionOrientationHalf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                app:optionTitle="Orientacion HalfDouble"
                app:optionDefaultIndex="0"
                app:optionTitleColor="#FFFFFF"
                app:optionTitleSize="16dp"
                app:optionTitleStyle="bold"
                app:optionTextColor="#FFFFFF"
                app:optionTextSize="11dp"
                app:optionTextStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/resourcesPanel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/fd_panel_glass"
            android:orientation="vertical"
            android:padding="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/gameplaySettingsPanel">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txResetChannels"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:shadowColor="#000000"
                    android:shadowDx="1.5"
                    android:shadowDy="1.3"
                    android:shadowRadius="1.6"
                    android:text="Reiniciar Canales"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.fingerdance.HoldProgressView
                    android:id="@+id/holdProgress"
                    android:layout_width="150dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="10dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txVersionNoteSkin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="45dp"
                android:gravity="center"
                android:text="Ultima versión de NoteSkins:"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txMyVersionNoteSkin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Tu versión de NoteSkins:"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnUptadeNoteSkin"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="ACTUALIZAR NOTESKINS"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>