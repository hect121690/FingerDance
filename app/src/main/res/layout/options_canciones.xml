<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutCanciones"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollChannels"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:padding="10dp"
        android:scrollbars="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/linearTextProgressChannel" />

    <TextView
        android:id="@+id/txSlide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Desliza para ver más"
        android:textColor="#FFD54F"
        android:textSize="12sp"
        android:textStyle="bold|italic"
        app:layout_constraintEnd_toEndOf="@+id/scrollChannels"
        app:layout_constraintStart_toStartOf="@+id/scrollChannels"
        app:layout_constraintTop_toBottomOf="@+id/scrollChannels" />

    <ImageView
        android:id="@+id/arrowIndicator"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:alpha="0.9"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="@+id/scrollChannels"
        app:layout_constraintStart_toStartOf="@+id/scrollChannels"
        app:layout_constraintTop_toBottomOf="@+id/txSlide"
        app:srcCompat="@android:drawable/arrow_down_float" />

    <LinearLayout
        android:id="@+id/songActionsPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/fd_panel_light"
        android:orientation="vertical"
        android:padding="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/download_button_channel"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="DESCARGAR SELECCIONADO"
            android:textColor="#FFFFFF"
            android:textSize="14dp"
            android:textStyle="bold"
            android:background="@drawable/fd_panel_glass"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:includeFontPadding="false"
            android:textAllCaps="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/installChannel"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Cargar ZIP"
                android:textColor="#FFFFFF"
                android:textSize="11dp"
                android:textStyle="bold"
                android:background="@drawable/fd_panel_glass"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:includeFontPadding="false"
                android:textAllCaps="false" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/createChannel"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Crear canal"
                android:textColor="#FFFFFF"
                android:textSize="11dp"
                android:textStyle="bold"
                android:background="@drawable/fd_panel_glass"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:includeFontPadding="false"
                android:textAllCaps="false" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/deleteChannel"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Borrar"
                android:textColor="#FFFFFF"
                android:textSize="11dp"
                android:textStyle="bold"
                android:background="@drawable/fd_panel_glass"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:includeFontPadding="false"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearTextProgressChannel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#88000000"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/textViewDownloadChannel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/progress_background"
            android:elevation="8dp"
            android:gravity="center"
            android:padding="12dp"
            android:textColor="@color/texto_textview_vibrante"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>