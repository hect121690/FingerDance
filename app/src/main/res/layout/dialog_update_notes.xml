<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#CC000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_update_dialog"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INFORMACIÓN"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="24sp"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Finger Dance 3.0.5"
                android:textColor="#00E5FF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#33FFFFFF"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"/>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:scrollbars="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• El Ranking Global fue reiniciado debido a ajustes realizados en el sistema de calificación de la aplicación.\n\n• Se integró soporte para archivos Lua exclusivos de Finger Dance, permitiendo añadir nuevos efectos visuales y transformaciones durante la jugabilidad.\n\n• Se agregó un fix para el mensaje de nivel modificado en canciones.\n\n• Mejoras generales de estabilidad y compatibilidad."
                        android:textColor="#DDDDDD"
                        android:textSize="15sp"
                        android:lineSpacingExtra="4dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⚠️ IMPORTANTE\n\nDebido a los cambios realizados en el sistema de evaluación, el Ranking Global anterior ya no es compatible con la nueva versión."
                        android:textColor="#FFD54F"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:layout_marginTop="18dp" />

                </LinearLayout>

            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="20dp">

                <Button
                    android:id="@+id/btnClose"
                    android:layout_width="220dp"
                    android:layout_height="@dimen/dialog_button_height"
                    android:text="Cerrar"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="@dimen/dialog_button_text"
                    android:background="@drawable/bg_button_close" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>