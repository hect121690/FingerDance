<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:id="@+id/bgNewOptions" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#99000000"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="18dp" android:paddingBottom="12dp">
        <TextView android:id="@+id/titleNewOptions" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginBottom="14dp" android:fontFamily="sans-serif-condensed" android:letterSpacing="0.08" android:text="FINGER DANCE OPTIONS" android:textAlignment="center" android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold" android:shadowColor="#00E5FF" android:shadowDx="0" android:shadowDy="0" android:shadowRadius="14"/>
        <com.google.android.material.tabs.TabLayout android:id="@+id/tabLayout" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginBottom="14dp" android:background="@drawable/fd_panel_glass" android:padding="4dp" app:tabGravity="fill" app:tabIndicator="@drawable/fd_tab_indicator" app:tabIndicatorColor="#00E5FF" app:tabIndicatorFullWidth="false" app:tabIndicatorHeight="4dp" app:tabMode="fixed" app:tabRippleColor="#33FF00FF" app:tabSelectedTextColor="#FFFFFF" app:tabTextColor="#B3FFFFFF"/>
        <androidx.viewpager2.widget.ViewPager2 android:id="@+id/viewPagerOptions" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    </LinearLayout>
</FrameLayout>